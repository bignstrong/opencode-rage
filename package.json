{
  "name": "@bignstrong/setup-opencode",
  "version": "0.1.1",
  "description": "OpenCode interface customizations and on-device dictation with a Rust core on macOS",
  "type": "module",
  "license": "MIT",
  "readmeFilename": "README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bignstrong/setup-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/bignstrong/setup-opencode/issues"
  },
  "homepage": "https://github.com/bignstrong/setup-opencode#readme",
  "main": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./tui": {
      "import": "./src/tui.ts"
    },
    "./runtime": {
      "import": "./lib/runtime.js"
    }
  },
  "bin": {
    "setup-opencode": "bin/setup-opencode",
    "opencode-voice": "bin/opencode-voice.js"
  },
  "files": [
    "assets/",
    "bin/",
    "lib/",
    "src/",
    "rage/core.ts",
    "rage/core.js",
    "src/native-runtime.js",
    "scripts/training_data.py",
    "native/rage.node",
    "native/target/release/rage-core",
    "index.js",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "PUBLISHING.md",
    "README.md",
    "docs/README*.md",
    "docs/performance.ru.md",
    "native/wake-assets/README.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build:native": "sh scripts/build-native.sh",
    "check": "npm run typecheck && node --check index.js && node --check lib/models.js && node --check lib/handy-model-catalog.js && node --check lib/download.js && node --check lib/engine.js && node --check lib/engines.js && node --check lib/settings.js && node --check lib/voice-controller.js && node --check lib/wav.js && node --check bin/opencode-voice.js && node --check scripts/package-engine-asset.mjs && node --check scripts/build-engine-registry.mjs && node --check scripts/update-handy-model-catalog.mjs && node --check scripts/gen-voice-fixtures.mjs && npm run lint && npm test",
    "test": "node --test \"test/*.test.js\"",
    "update-handy-model-catalog": "node scripts/update-handy-model-catalog.mjs",
    "prepack": "node scripts/prepack.mjs && npm run check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint test/ src/ scripts/gen-voice-fixtures.mjs && oxfmt --check src test scripts/gen-voice-fixtures.mjs tsconfig.json"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.3",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "ffmpeg-static": "^5.2.0",
    "solid-js": "1.9.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@opencode/plugin": {
      "zod": "4.6.6"
    },
    "solid-js": {
      "seroval": "1.6.11",
      "seroval-plugins": "1.6.11"
    }
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.4 <2"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "voice",
    "speech-to-text",
    "whisper",
    "whisper.cpp"
  ],
  "engines": {
    "node": ">=22",
    "opencode": ">=1.17.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "5.9.3"
  }
}
